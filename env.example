# Скопируй в .env для локального запуска и подставь свои значения.
# На Render эти же переменные задаются в Dashboard → Environment,
# сам .env туда заливать не нужно (и нельзя — он в .gitignore).

TG_API_ID=
TG_API_HASH=
TG_SESSION=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

CATGIRL_MIN_DELAY=1
CATGIRL_MAX_DELAY=5

REMEMBER_MAX_MESSAGES=10000

SPAM_MAX=50
SPAM_DELAY=0.8

# На Render НЕ задавать — на Linux tesseract уже в PATH после
# установки пакета tesseract-ocr в Dockerfile.
# TESSERACT_CMD=

SAVE_DELETED_MEDIA=true
